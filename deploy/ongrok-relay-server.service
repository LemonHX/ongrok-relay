[Unit]
Description=ongrok relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ongrok
Group=ongrok
EnvironmentFile=/etc/ongrok/server.env
ExecStart=/opt/ongrok/bin/ongrok-relay-server run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ongrok
LimitNOFILE=131072

[Install]
WantedBy=multi-user.target
