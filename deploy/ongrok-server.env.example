# Copy to /etc/ongrok/server.env and restrict it to root (0600).
ONGROK_TLS_CERT=/etc/ongrok/certs/fullchain.pem
ONGROK_TLS_KEY=/etc/ongrok/certs/privkey.pem
ONGROK_DB_PATH=/var/lib/ongrok/ongrok.redb
ONGROK_API_LISTEN=127.0.0.1:8080
ONGROK_QUIC_LISTEN=0.0.0.0:443
ONGROK_TCP_TLS_LISTEN=0.0.0.0:8443
ONGROK_HTTP_LISTEN=0.0.0.0:80
ONGROK_HTTPS_LISTEN=0.0.0.0:443
ONGROK_HTTP_DOMAIN=relay.example.com
ONGROK_PUBLIC_HOST=relay.example.com
ONGROK_TCP_PORT_START=20000
ONGROK_TCP_PORT_END=30000
# Generate with: ongrok-relay-server token create --kind admin/user
ONGROK_ADMIN_TOKEN=replace-with-admin-token
ONGROK_USER_TOKEN=replace-with-user-token
